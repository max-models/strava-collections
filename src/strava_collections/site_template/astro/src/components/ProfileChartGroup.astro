---
interface Props {
  id: string;
  curves: {
    windowsSeconds: number[];
    windowLabels: string[];
    power: (number | null)[];
    speedKmh: (number | null)[];
    elevationGainMH: (number | null)[];
  };
  height?: number;
}

const { id, curves, height = 320 } = Astro.props;

const METRIC_DEFS: Array<{ key: string; label: string; unit: string; color: string }> = [
  { key: 'power', label: 'Power', unit: 'W', color: '#16a34a' },
  { key: 'speedKmh', label: 'Speed', unit: 'km/h', color: '#0ea5e9' },
  { key: 'elevationGainMH', label: 'Elevation Gain Rate', unit: 'm/h', color: '#0d9488' },
];

const availableMetrics = METRIC_DEFS.filter(
  (metric) => Array.isArray((curves as any)?.[metric.key]) && (curves as any)[metric.key].length > 0,
);

const serializeDataForScript = (value: unknown): string => {
  const json = JSON.stringify(value || {});
  return json.replace(/</g, "\u003c").replace(/>/g, "\u003e").replace(/&/g, "\u0026");
};
---

{availableMetrics.length > 0 && (
  <div class="profile-trace">
    <div class="profile-trace-controls">
      <div class="profile-trace-control">
        <span>Metrics</span>
        <div class="profile-trace-metrics" id={`${id}-metrics`}>
          {availableMetrics.map((metric, index) => (
            <label class="profile-trace-metric-pill" style={`--metric-color: ${metric.color};`}>
              <input
                type="checkbox"
                name={`${id}-metric`}
                value={metric.key}
                checked={index === 0}
              />
              <span>{metric.label}</span>
            </label>
          ))}
        </div>
      </div>
    </div>
    <div id={id} style={`height: ${height}px; width: 100%;`}></div>
  </div>
)}

<script id={`${id}-data`} type="application/json" set:html={serializeDataForScript(curves)}></script>
<script id={`${id}-metric-defs`} type="application/json" set:html={serializeDataForScript(METRIC_DEFS)}></script>

<script is:inline define:vars={{ id }}>
  (function () {
    // Builds one y-axis per selected metric. The first two use the
    // standard left/right axes; any further axes are "free" and offset
    // outward from the plot area so they don't overlap each other.
    function buildYAxes(selectedKeys, colorForKey) {
      const axes = {};
      const extra = Math.max(0, selectedKeys.length - 2);
      const leftExtra = Math.ceil(extra / 2);
      const rightExtra = Math.floor(extra / 2);
      const step = 0.07;
      const domainStart = leftExtra * step;
      const domainEnd = 1 - rightExtra * step;

      let leftOffset = 0;
      let rightOffset = 0;

      selectedKeys.forEach((key, idx) => {
        const color = colorForKey(key);
        const axisName = idx === 0 ? 'yaxis' : `yaxis${idx + 1}`;
        const isLeft = idx % 2 === 0;

        const axis = {
          type: 'log',
          tickfont: { size: 9, color },
          showgrid: idx === 0,
          gridcolor: '#f1f5f9',
          zeroline: false,
        };

        if (idx === 0) {
          axis.side = 'left';
        } else if (idx === 1) {
          axis.overlaying = 'y';
          axis.side = 'right';
        } else {
          axis.overlaying = 'y';
          axis.anchor = 'free';
          if (isLeft) {
            axis.side = 'left';
            axis.position = Math.max(0, domainStart - step * leftOffset);
            leftOffset += 1;
          } else {
            axis.side = 'right';
            axis.position = Math.min(1, domainEnd + step * rightOffset);
            rightOffset += 1;
          }
        }

        axes[axisName] = axis;
      });

      return { axes, xaxisDomain: [domainStart, domainEnd] };
    }

    function init() {
      const container = document.getElementById(id);
      const dataEl = document.getElementById(`${id}-data`);
      const metricDefsEl = document.getElementById(`${id}-metric-defs`);
      if (!container || !dataEl?.textContent || !window.Plotly) return;

      const curves = JSON.parse(dataEl.textContent);
      const metricDefs = metricDefsEl?.textContent ? JSON.parse(metricDefsEl.textContent) : [];
      const metricByKey = Object.fromEntries(metricDefs.map((m) => [m.key, m]));

      const xValues = curves.windowsSeconds || [];
      const xLabels = curves.windowLabels || [];
      if (xValues.length === 0) return;

      const metricInputs = Array.from(
        document.querySelectorAll(`input[name="${id}-metric"]`),
      );

      function colorForKey(key) {
        return metricByKey[key]?.color || '#fc4c02';
      }

      function selectedKeys() {
        return metricInputs.filter((input) => input.checked).map((input) => input.value);
      }

      function render() {
        const keys = selectedKeys();
        if (keys.length === 0) return;

        const { axes, xaxisDomain } = buildYAxes(keys, colorForKey);

        const traces = keys.map((key, idx) => {
          const metric = metricByKey[key];
          const values = curves[key] || [];
          const points = xValues
            .map((x, i) => ({ x, y: values[i], label: xLabels[i] }))
            .filter((point) => point.y != null);

          const color = colorForKey(key);
          const axisNum = idx === 0 ? '' : String(idx + 1);

          return {
            x: points.map((point) => point.x),
            y: points.map((point) => point.y),
            text: points.map((point) => point.label),
            name: `${metric.label} (${metric.unit})`,
            type: 'scatter',
            mode: 'lines+markers',
            line: { color, width: 2.5, shape: 'spline' },
            marker: { color, size: 6 },
            yaxis: `y${axisNum}`,
            hovertemplate: `%{text}: %{y:.1f} ${metric.unit}<extra>${metric.label}</extra>`,
          };
        });

        const layout = {
          height: container.clientHeight || 320,
          margin: { l: 55, r: 20, t: 10, b: 40 },
          showlegend: keys.length > 1,
          legend: { orientation: 'h', y: 1.15, font: { size: 10 } },
          xaxis: {
            type: 'log',
            domain: xaxisDomain,
            tickvals: xValues,
            ticktext: xLabels,
            showgrid: true,
            gridcolor: '#f1f5f9',
            zeroline: false,
            tickfont: { size: 10, color: '#94a3b8' },
            fixedrange: true,
          },
          paper_bgcolor: 'rgba(0,0,0,0)',
          plot_bgcolor: 'rgba(0,0,0,0)',
          dragmode: false,
          ...axes,
        };

        window.Plotly.react(id, traces, layout, {
          responsive: true,
          displayModeBar: false,
          scrollZoom: false,
        });
      }

      render();

      metricInputs.forEach((input) => {
        input.addEventListener('change', () => {
          if (selectedKeys().length === 0) {
            input.checked = true;
            return;
          }
          render();
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
    document.addEventListener('astro:after-swap', init);
  })();
</script>

<style>
  .profile-trace {
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
  }

  .profile-trace-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .profile-trace-control {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .profile-trace-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .profile-trace-metric-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1.5px solid var(--metric-color);
    background: color-mix(in srgb, var(--metric-color) 10%, white);
    font-size: 0.8rem;
    font-weight: 500;
    color: #0f172a;
    text-transform: none;
    letter-spacing: normal;
    cursor: pointer;
    user-select: none;
  }

  .profile-trace-metric-pill input {
    accent-color: var(--metric-color);
  }
</style>
