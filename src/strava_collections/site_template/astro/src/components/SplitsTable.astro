---
interface Split {
  index: number;
  distanceKm: number;
  time: string;
  paceOrSpeed: string | null;
  elevationGainM: number | null;
  avgHeartRate: number | null;
  avgPower: number | null;
}

interface Props {
  splits: Split[];
  isPace: boolean;
}

const { splits, isPace } = Astro.props;

const hasElevation = splits.some((split) => split.elevationGainM != null);
const hasHeartRate = splits.some((split) => split.avgHeartRate != null);
const hasPower = splits.some((split) => split.avgPower != null);
---

{splits.length > 0 && (
  <div class="splits-table-wrapper">
    <table class="splits-table">
      <thead>
        <tr>
          <th>Split</th>
          <th>Distance</th>
          <th>Time</th>
          <th>{isPace ? 'Pace' : 'Speed'}</th>
          {hasElevation && <th>Elev. Gain</th>}
          {hasHeartRate && <th>Avg HR</th>}
          {hasPower && <th>Avg Power</th>}
        </tr>
      </thead>
      <tbody>
        {splits.map((split) => (
          <tr>
            <td>{split.index}</td>
            <td>{split.distanceKm} km</td>
            <td>{split.time}</td>
            <td>{split.paceOrSpeed ?? '-'}</td>
            {hasElevation && <td>{split.elevationGainM != null ? `${split.elevationGainM} m` : '-'}</td>}
            {hasHeartRate && <td>{split.avgHeartRate != null ? `${split.avgHeartRate} bpm` : '-'}</td>}
            {hasPower && <td>{split.avgPower != null ? `${split.avgPower} W` : '-'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

<style>
  .splits-table-wrapper {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }

  .splits-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .splits-table th {
    background: #f1f5f9;
    padding: 10px 14px;
    text-align: left;
    white-space: nowrap;
    font-weight: 600;
    color: #334155;
    border-bottom: 2px solid #e2e8f0;
  }

  .splits-table td {
    padding: 8px 14px;
    border-bottom: 1px solid #e2e8f0;
    color: #475569;
    white-space: nowrap;
  }

  .splits-table tr:last-child td {
    border-bottom: none;
  }

  .splits-table tbody tr:hover {
    background: #f8fafc;
  }
</style>
