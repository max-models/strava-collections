---
interface Props {
  id: string;
  title: string;
  xValues: number[];
  xLabels: string[];
  yValues: (number | null)[];
  yUnit: string;
  color?: string;
  height?: number;
}

const {
  id,
  title,
  xValues,
  xLabels,
  yValues,
  yUnit,
  color = '#fc4c02',
  height = 260,
} = Astro.props;
---

<div class="profile-chart">
  <h3 class="profile-chart-title">{title}</h3>
  <div id={id} style={`height: ${height}px; width: 100%;`}></div>
</div>

<script is:inline define:vars={{ id, xValues, xLabels, yValues, yUnit, color, height }}>
  (function () {
    function renderChart() {
      const container = document.getElementById(id);
      if (!container || !window.Plotly) return;

      const points = xValues
        .map((x, i) => ({ x, y: yValues[i], label: xLabels[i] }))
        .filter((point) => point.y != null);

      if (points.length === 0) {
        container.innerHTML =
          '<p style="color:#94a3b8; font-size:0.875rem;">No data available.</p>';
        return;
      }

      const trace = {
        x: points.map((point) => point.x),
        y: points.map((point) => point.y),
        text: points.map((point) => point.label),
        type: 'scatter',
        mode: 'lines+markers',
        line: { color, width: 2.5, shape: 'spline' },
        marker: { color, size: 6 },
        hovertemplate: `%{text}: %{y:.1f} ${yUnit}<extra></extra>`,
      };

      const layout = {
        height,
        margin: { l: 55, r: 20, t: 10, b: 40 },
        showlegend: false,
        xaxis: {
          type: 'log',
          tickvals: points.map((point) => point.x),
          ticktext: points.map((point) => point.label),
          showgrid: true,
          gridcolor: '#f1f5f9',
          zeroline: false,
          tickfont: { size: 10, color: '#94a3b8' },
          fixedrange: true,
        },
        yaxis: {
          type: 'log',
          title: { text: yUnit, font: { size: 11, color: '#64748b' } },
          showgrid: true,
          gridcolor: '#f1f5f9',
          zeroline: false,
          tickfont: { size: 10, color: '#94a3b8' },
          fixedrange: true,
        },
        paper_bgcolor: 'rgba(0,0,0,0)',
        plot_bgcolor: 'rgba(0,0,0,0)',
        dragmode: false,
      };

      window.Plotly.newPlot(id, [trace], layout, {
        responsive: true,
        displayModeBar: false,
        scrollZoom: false,
      });
    }

    renderChart();
    document.addEventListener('astro:after-swap', renderChart);
  })();
</script>

<style>
  .profile-chart {
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
  }

  .profile-chart-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.5rem;
  }
</style>
