---
import Layout from '../layouts/Layout.astro';
import ComparisonWorkspace from '../components/ComparisonWorkspace.astro';
import { activities } from '../generated/activities';

const sortedActivities = [...activities].sort((a, b) =>
  String(b.metadata.date || '').localeCompare(String(a.metadata.date || '')),
);
---

<Layout title="Compare Activities" wide={true} includePlotly={true}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Compare activities</h1>
    <p class="mt-2 max-w-3xl text-slate-500 dark:text-slate-400">
      Pick any two activities to compare their stats and time-series metrics side by side.
    </p>
  </div>
  <ComparisonWorkspace activities={sortedActivities} />
</Layout>
