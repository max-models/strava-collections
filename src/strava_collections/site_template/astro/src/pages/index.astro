---
import Layout from '../layouts/Layout.astro';
import CollectionCard from '../components/CollectionCard.astro';
import { collections } from '../generated/collections';
import fs from 'fs';
import path from 'path';
import yaml from 'js-yaml';

const sorted = [...collections].sort((a, b) =>
  a.title.localeCompare(b.title)
);

// The Python build syncs to site_root/source/live-tracking.yaml when
// --livetrack is given. Astro bundles page code into dist/.prerender/chunks/
// at build time, so import.meta.url no longer points at the source
// directory there — resolve relative to process.cwd() instead (typically
// the astro/ project root), same approach as scripts/data-helpers.ts.
const LIVE_TRACKING_YAML_CANDIDATES = [
  path.join(process.cwd(), '../source/live-tracking.yaml'),
  path.join(process.cwd(), 'source/live-tracking.yaml'),
  path.join(process.cwd(), '../../source/live-tracking.yaml'),
];
const liveTrackingPath = LIVE_TRACKING_YAML_CANDIDATES.find((p) => fs.existsSync(p)) || null;

let hasLiveTracking = false;
if (liveTrackingPath) {
  try {
    const liveTrackingConfig = yaml.load(fs.readFileSync(liveTrackingPath, 'utf8')) as {
      garminLivetrackUrl?: string;
    };
    hasLiveTracking = !!liveTrackingConfig?.garminLivetrackUrl;
  } catch (error) {
    console.error('Error reading live-tracking.yaml:', error);
  }
}
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Home">
  <div class="mb-10 text-center">
    <h1 class="mb-2 text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
      Max's Runs &amp; Rides
    </h1>
    <p class="text-lg text-slate-500 dark:text-slate-400">
      A personal archive of multi-day adventures tracked on Strava.
    </p>
    {hasLiveTracking && (
      <div class="mt-4">
        <a
          href={`${base}live-tracking`}
          class="inline-flex items-center gap-2 px-6 py-3 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg transition-colors shadow-md"
        >
          <span class="inline-block w-3 h-3 bg-white rounded-full animate-pulse"></span>
          Live Tracking
        </a>
      </div>
    )}
  </div>

  {sorted.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-8 py-20 text-center text-slate-400">
      <p class="text-lg font-medium">No collections yet.</p>
      <p class="mt-1 text-sm">
        Collections are generated by the Python pipeline and synced into Astro pages during CI.
      </p>
    </div>
  ) : (
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {sorted.map((entry) => {
        return (
          <CollectionCard
            title={entry.title}
            slug={entry.slug}
            fileSlug={entry.fileSlug}
          />
        );
      })}
    </div>
  )}
</Layout>
