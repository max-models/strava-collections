---
import fs from 'fs';
import path from 'path';
import yaml from 'js-yaml';
import Layout from '../layouts/Layout.astro';
import { collections } from '../generated/collections';

// The Python build syncs to site_root/source/live-tracking.yaml when
// --livetrack is given. Astro bundles page code into dist/.prerender/chunks/
// at build time, so import.meta.url no longer points at the source
// directory there — resolve relative to process.cwd() instead (typically
// the astro/ project root), same approach as scripts/data-helpers.ts.
const LIVE_TRACKING_YAML_CANDIDATES = [
  path.join(process.cwd(), '../source/live-tracking.yaml'),
  path.join(process.cwd(), 'source/live-tracking.yaml'),
  path.join(process.cwd(), '../../source/live-tracking.yaml'),
];

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const liveTrackingPath = LIVE_TRACKING_YAML_CANDIDATES.find((p) => fs.existsSync(p)) || null;

let sessionName = '';
let customText = '';
let garminUrl: string | null = null;
let associatedCollectionHref: string | null = null;
let associatedCollectionTitle: string | null = null;

if (liveTrackingPath) {
  try {
    // Flat schema: this page just wraps a Garmin LiveTrack embed, with no
    // notion of Strava activities.
    const config = yaml.load(fs.readFileSync(liveTrackingPath, 'utf8')) as {
      name?: string;
      garminLivetrackUrl?: string;
      associatedCollection?: string;
      customText?: string;
      active?: boolean;
    } | null;

    if (config) {
      sessionName = config.name || '';
      customText = config.customText || '';
      // `active: false` hides the embed even if a URL is still configured
      // (e.g. keeping the session on file between tracking windows).
      garminUrl = config.active !== false ? config.garminLivetrackUrl || null : null;

      const associated = config.associatedCollection;
      if (associated) {
        const normalized = String(associated).trim().toLowerCase();
        const match = collections.find(
          (c) => c.slug.toLowerCase() === normalized || c.title.toLowerCase() === normalized,
        );
        if (match) {
          associatedCollectionHref = `${base}collections/${match.slug}/`;
          associatedCollectionTitle = match.title;
        }
      }
    }
  } catch (error) {
    console.error('Error reading live-tracking.yaml:', error);
  }
}
---

<Layout title="Live Tracking">
  <div class="mx-auto max-w-3xl">
    <div class="mb-8">
      <h1 class="mb-2 flex items-center gap-3 text-3xl font-bold text-slate-900 dark:text-slate-100 md:text-4xl">
        <span class="inline-block h-3 w-3 animate-pulse rounded-full bg-red-500"></span>
        Live Tracking
      </h1>
      {sessionName && <p class="text-lg text-slate-500 dark:text-slate-400">{sessionName}</p>}
    </div>

    {associatedCollectionHref && (
      <a
        href={associatedCollectionHref}
        class="group mb-8 flex items-center justify-between gap-4 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 shadow-sm transition-colors hover:border-strava"
      >
        <div>
          <span class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500">
            Associated Collection
          </span>
          <span class="text-lg font-semibold text-slate-900 dark:text-slate-100 transition-colors group-hover:text-strava">
            {associatedCollectionTitle}
          </span>
        </div>
        <svg
          class="h-5 w-5 flex-shrink-0 text-slate-400 transition-colors group-hover:text-strava"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    )}

    {customText && (
      <div class="mb-8 leading-relaxed text-slate-600 dark:text-slate-400" set:html={customText} />
    )}

    {garminUrl ? (
      <div class="overflow-hidden rounded-xl border-[3px] border-red-500 bg-slate-50 dark:bg-slate-900 shadow-sm">
        <iframe src={garminUrl} class="h-[500px] w-full border-none md:h-[750px]" title="Garmin LiveTrack Map"></iframe>
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-8 py-20 text-center text-slate-400">
        <p class="text-lg font-medium">No live tracking session is currently active.</p>
      </div>
    )}
  </div>
</Layout>
