---
import CollectionPage from '../../components/CollectionPage.astro';
import Map from '../../components/Map.astro';
import ElevationChart from '../../components/ElevationChart.astro';
import ProfileChartGroup from '../../components/ProfileChartGroup.astro';
import TimeSeriesChart from '../../components/TimeSeriesChart.astro';
import StopTimeChart from '../../components/StopTimeChart.astro';
import PaceHistogramChart from '../../components/PaceHistogramChart.astro';
import SplitsTable from '../../components/SplitsTable.astro';
import {{ loadStravaRouteData }} from '../../scripts/data-helpers';

const title = {title_json};
const headings = {headings_json};
const metadata = {metadata_json};
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${{import.meta.env.BASE_URL}}/`;

const activityEntry = {{
  strava_id: [metadata.activityId, metadata.flip || false],
  notes: title,
}};
const stravaRouteData = loadStravaRouteData([activityEntry]);
const routeData = stravaRouteData[0];

const trackerPayload = {{
  collections: [{{
    name: title,
    color: '#fc4c02',
    activities: [{{
      ...activityEntry,
      color: '#fc4c02',
      routeData,
    }}],
  }}],
}};

let elevationData = [];
if (routeData?.status === "ok") {{
  const points = [...routeData.points];
  if (metadata.flip) {{
    points.reverse();
  }}

  const x = [];
  const y = [];
  let dist = 0;
  for (let i = 0; i < points.length; i++) {{
    if (i > 0) {{
      const p1 = points[i - 1];
      const p2 = points[i];
      const R = 6371; // km
      const dLat = (p2.lat - p1.lat) * Math.PI / 180;
      const dLon = (p2.lon - p1.lon) * Math.PI / 180;
      const a = Math.sin(dLat / 2) ** 2 +
        Math.cos(p1.lat * Math.PI / 180) * Math.cos(p2.lat * Math.PI / 180) *
        Math.sin(dLon / 2) ** 2;
      dist += R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }}
    x.push(dist);
    y.push(points[i].elevation || 0);
  }}
  elevationData = [{{ x, y, color: '#fc4c02', name: title }}];
}}

const stats = [
  {{ label: 'Distance', value: metadata.distanceKm != null ? `${{metadata.distanceKm}} km` : null }},
  {{ label: 'Elevation Gain', value: metadata.elevationGainM != null ? `${{metadata.elevationGainM}} m` : null }},
  {{ label: 'Moving Time', value: metadata.movingTime }},
  {{ label: 'Elapsed Time', value: metadata.elapsedTime }},
  {{ label: 'Avg Pace', value: metadata.avgPace }},
  {{ label: 'Fastest Pace', value: metadata.maxPace }},
  {{ label: 'Avg Speed', value: metadata.avgSpeedKmh != null ? `${{metadata.avgSpeedKmh}} km/h` : null }},
  {{ label: 'Max Speed', value: metadata.maxSpeedKmh != null ? `${{metadata.maxSpeedKmh}} km/h` : null }},
  {{ label: 'Avg Heart Rate', value: metadata.avgHeartRate != null ? `${{metadata.avgHeartRate}} bpm` : null }},
  {{ label: 'Max Heart Rate', value: metadata.maxHeartRate != null ? `${{metadata.maxHeartRate}} bpm` : null }},
  {{ label: 'Avg Power', value: metadata.avgWatts != null ? `${{metadata.avgWatts}} W` : null }},
  {{ label: 'Calories', value: metadata.calories != null ? `${{metadata.calories}} kcal` : null }},
].filter((stat) => stat.value != null);

const profileCurves = metadata.profileCurves || {{}};
const hasProfileCurves = ['power', 'speedKmh', 'elevationGainMH'].some(
  (key) => Array.isArray(profileCurves[key]) && profileCurves[key].length > 0,
);

const timeSeries = metadata.timeSeries || {{ timeS: [], distanceKm: [], series: {{}} }};
const stopTimeHistogram = metadata.stopTimeHistogram || {{}};
const paceHistogram = metadata.paceHistogram || {{ labels: [], minutes: [] }};
const splitsData = metadata.splits || {{ splits: [], isPace: false }};
---

<CollectionPage title={{title}} headings={{headings}}>
  <nav class="activity-back-link mb-4">
    <a href={{`${{base}}`}}>Back to Collections</a>
  </nav>
  <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-100 mb-2 break-words">{{title}}</h1>
  {{metadata.date && (
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-8">{{metadata.date}}{{metadata.activityType ? ` · ${{metadata.activityType}}` : ''}}</p>
  )}}

  <section class="activity-stats-section mb-8 w-full overflow-hidden">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm px-3 py-3 md:px-4 md:py-4">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-4 gap-y-3">
        {{stats.map((stat) => (
          <div class="min-w-0 px-1">
            <span class="block text-[10px] font-bold text-orange-600 dark:text-orange-400 uppercase tracking-widest mb-0.5">{{stat.label}}</span>
            <strong class="block text-base md:text-lg font-semibold text-slate-900 dark:text-slate-100 truncate">{{stat.value}}</strong>
          </div>
        ))}}
      </div>
    </div>
  </section>

  {{routeData?.status === "ok" && (
    <>
      <ElevationChart id="activity-elevation" data={{elevationData}} height={{240}} />
      <Map payload={{trackerPayload}} />
    </>
  )}}

  {{Object.keys(timeSeries.series || {{}}).length > 0 && (
    <section class="activity-trace-section mb-12 w-full overflow-hidden">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-4">Time Trace</h2>
      <TimeSeriesChart id="activity-trace" timeSeries={{timeSeries}} height={{320}} />
    </section>
  )}}

  {{hasProfileCurves && (
    <section class="activity-profiles-section mb-12 w-full overflow-hidden">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-4">Effort Profile</h2>
      <ProfileChartGroup id="activity-profile" curves={{profileCurves}} height={{320}} />
    </section>
  )}}

  {{paceHistogram.minutes && paceHistogram.minutes.some((v) => v > 0) && (
    <section class="activity-pace-histogram-section mb-12 w-full overflow-hidden">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-4">
        {{paceHistogram.isPace ? 'Pace Distribution' : 'Speed Distribution'}}
      </h2>
      <PaceHistogramChart id="activity-pace-histogram" histogram={{paceHistogram}} height={{260}} />
    </section>
  )}}

  {{stopTimeHistogram.totalStopsCount > 0 && (
    <section class="activity-stops-section mb-12 w-full overflow-hidden">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-4">Stops</h2>
      <StopTimeChart id="activity-stops" histogram={{stopTimeHistogram}} height={{260}} />
    </section>
  )}}

  {markup}

  {{splitsData.splits.length > 0 && (
    <section class="activity-splits-section mb-12 w-full overflow-hidden">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-4">Splits</h2>
      <SplitsTable splits={{splitsData.splits}} isPace={{splitsData.isPace}} />
    </section>
  )}}

  {{metadata.stravaLink && (
    <p class="mt-8">
      <a href={{metadata.stravaLink}} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-slate-900 hover:bg-gray-50 dark:hover:bg-slate-800 text-orange-600 dark:text-orange-400 font-semibold rounded-lg border-2 border-orange-500 dark:border-orange-700 transition-colors shadow-sm text-sm">
        View on Strava
      </a>
    </p>
  )}}
</CollectionPage>

<style is:global>
  .activity-back-link a {{
    color: #fc4c02;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
  }}

  .activity-back-link a:hover {{
    text-decoration: underline;
  }}
</style>
